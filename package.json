{
  "name": "trimhook",
  "version": "0.2.0",
  "description": "Tool output trimmed at the source: a PostToolUse hook for Claude Code and Codex CLI that keeps the head and tail of a long shell result, spills the whole of it to a file the model can read, and reports what it saved.",
  "type": "module",
  "bin": {
    "trimhook": "bin/trimhook.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "codex",
    ".claude-plugin",
    ".codex-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node bin/trimhook.mjs check && node --test",
    "backlog": "npx --yes backlogsync@0.1.1 check",
    "build:site": "node site/build.mjs",
    "build:social": "node scripts/social.mjs",
    "roadmap": "npx --yes backlogsync@0.1.1 roadmap"
  },
  "backlogsync": {
    "prefix": "TH",
    "name": "trimhook",
    "regenerate": "npm run roadmap",
    "labels": {
      "hook": [
        "b7552f",
        "The hook itself: trimming, spill, harness shapes"
      ],
      "benchmark": [
        "0e8a16",
        "Measurement and evals"
      ],
      "release": [
        "5319e7",
        "Publishing and versioning"
      ],
      "docs": [
        "0075ca",
        "README, CONTRIBUTING, site"
      ],
      "project": [
        "6a737d",
        "Backlog, roadmap, repo hygiene"
      ],
      "tests": [
        "d4c5f9",
        "Test coverage and test tooling"
      ],
      "enhancement": [
        "a2eeef",
        "New capability"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allan-Nava/trimhook.git"
  },
  "homepage": "https://allan-nava.github.io/trimhook/",
  "bugs": "https://github.com/Allan-Nava/trimhook/issues",
  "keywords": [
    "claude-code",
    "codex",
    "hooks",
    "plugin",
    "token-efficiency",
    "context-engineering",
    "tool-output",
    "truncation"
  ],
  "author": "Allan Nava (https://github.com/Allan-Nava)",
  "license": "MIT",
  "devDependencies": {
    "marked": "^17.0.0"
  }
}
